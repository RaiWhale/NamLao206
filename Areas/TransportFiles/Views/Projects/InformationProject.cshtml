                                                                <td>
                                                                    @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriPLHopDong)
                                                                </td>
                                                            }
                                                            @if (Model.GiamSatThiCongs.Any(g => g.LandVolumeContract != null))
