@model NamLao206.Models.Project
@using NamLao206.Models;

@{

}
@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)
    <!-- Hiển thị thông báo (nếu có) -->
    <div id="alert-container" data-message="@Html.Raw(HttpUtility.HtmlEncode(ViewBag.Message))"></div>
    <div class="row">
        <div class="container-fluid" style="margin-top:5px">
            <div class="col-lg-12 col-sm-12 col-xs-12">
                <div id="panel-2" class="panel panel-collapsed">
                    <div class="panel-hdr">
                        <h2 style="font-size: 150%">
                            Tạo mới <span class="fw-300"><i><b class="color-success-900">và tìm kiếm dự án</b></i></span>
                        </h2>
                    </div>
                    <div class="panel-container show">
                        <div class="panel-content">
                            @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <a href="@Url.Action(Model.DM_DonVis?.CreateBranch ?? "Create","Khaosats", new {projectID = Model.Id})" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                            <span class="fal fa-download mr-1"></span>Khảo sát
                                        </a>
                                    </div>
                                    <div class="input-group-prepend">
                                        <a href="@Url.Action(Model.DM_DonVis?.CreateBranch ?? "Create","GiamSatThiCongs",new {projectID = Model.Id})" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                            <span class="fal fa-download mr-1"></span>Giám sát
                                        </a>
                                    </div>
                                    <div class="input-group-prepend">
                                        <a href="@Url.Action(Model.DM_DonVis?.CreateBranch ?? "Create","ThiCongs",new {projectID = Model.Id})" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                            <span class="fal fa-download mr-1"></span>Thi công
                                        </a>
                                    </div>
                                    <div class="input-group-prepend">
                                        <a href="@Url.Action(Model.DM_DonVis?.CreateBranch ?? "Create","NghiemThus", new {projectID = Model.Id})" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                            <span class="fal fa-vote-yea mr-1"></span>Nghiệm thu
                                        </a>
                                    </div>
                                    <div class="input-group-prepend">
                                        <a href="@Url.Action("Create","HoSoPhapLies",new {projectID = Model.Id})" class="bcommand btn btn-md btn-primary waves-effect waves-themed">
                                            <span class="fal fa-folder mr-1"></span>Hồ sơ pháp lý
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="container-fluid" style="margin-top:5px">
            @if (Model.KhaoSats != null && Model.KhaoSats.Any())
            {
                <div class="col-lg-12 col-sm-12 col-xs-12 ">
                    <div id="panel-1" class="panel">
                        <div class="panel-hdr">
                            <h2>
                                Quản lý <span class="fw-300"><i>khảo sát</i></span>
                            </h2>
                        </div>
                        <div class="panel-container show">
                            <div class="panel-content">
                                <div class="form-horizontal">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-hover table-striped w-100 dt-basic-example" style="font-size: calc(0.3vw + 10px) ">
                                            <thead class="bg-warning-200 text-center">
                                                <tr>
                                                    @if (Model.KhaoSats.Any(k => k.GiaTriHopDong != null))
                                                    {
                                                        <th>Giá trị hợp đồng</th>
                                                    }
