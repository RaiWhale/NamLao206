                                                    {
                                                        <th>Kết quả khảo sát</th>
                                                    }
                                                    @if (Model.KhaoSats.Any(k => k.ChiPhiGiamSat != null))
                                                    {
                                                        <th>Chi phí giám sát</th>
                                                    }
                                                    @if (Model.KhaoSats.Any(k => k.LandArea != null))
                                                    {
                                                        <th>Diện tích đất</th>
                                                    }
                                                    @if (Model.KhaoSats.Any(k => k.WaterArea != null))
                                                    {
                                                        <th>Diện tích vùng nước</th>
                                                    }
                                                    @if (Model.KhaoSats.Any(k => k.LandAreaKhaoSat != null))
                                                    {
                                                        <th>Diện tích đất khảo sát</th>
                                                    }
                                                    @if (Model.KhaoSats.Any(k => k.WaterAreaKhaoSat != null))
                                                    {
                                                        <th>Diện tích vùng nước khảo sát</th>
                                                    }
                                                    @if (Model.KhaoSats.Any(k => k.NguoiGiamSat != null))
                                                    {
                                                        <th>Người giám sát</th>
                                                    }

                                                    <th>Tình trạng công nợ</th>

                                                    @if (Model.KhaoSats.Any(k => k.Note != null))
                                                    {
                                                        <th>Note</th>
                                                    }
                                                    @if (Model.KhaoSats.Any(k => k.DocumentType != null))
                                                    {
                                                        <th>Loại hợp đồng</th>
                                                    }
                                                    @if (Model.KhaoSats.Any(k => k.Supplier != null))
                                                    {
                                                        <th>Đơn vị khảo sát</th>
                                                    }
                                                    @if (Model.KhaoSats.Any(k => k.StatusProject != null))
                                                    {
                                                        <th>Trạng thái</th>
                                                    }
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.KhaoSats)
                                                {
                                                    if (item.IsActive == true)
                                                    {
                                                        <tr>
                                                            @if (Model.KhaoSats.Any(k => k.GiaTriHopDong != null))
                                                            {
                                                                <td>
                                                                    @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriHopDong)
                                                                </td>
                                                            }
                                                            @if (Model.KhaoSats.Any(k => k.GiaTriPLHopDong != null))
                                                            {
                                                                <td>
                                                                    @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriPLHopDong)
                                                                </td>
                                                            }
                                                            @if (Model.KhaoSats.Any(k => k.GiaTriDuToan != null))
                                                            {
                                                                <td>
                                                                    @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriDuToan)
                                                                </td>
                                                            }
                                                            @if (Model.KhaoSats.Any(k => k.GiaTriKhaoSat != null))
                                                            {
                                                                <td>
                                                                    @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriKhaoSat)
                                                                </td>
                                                            }
                                                            @if (Model.KhaoSats.Any(k => k.GiaTriThamDinh != null))
                                                            {
                                                                <td>
                                                                    @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriThamDinh)
                                                                </td>
                                                            }
                                                            @if (Model.KhaoSats.Any(k => k.GiaTriDuToanPheDuyet != null))
                                                            {
                                                                <td>
                                                                    @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriDuToanPheDuyet)
                                                                </td>
                                                            }
                                                            @if (Model.KhaoSats.Any(k => k.GiaTriKhaoSatPheDuyet != null))
                                                            {
                                                                <td>
                                                                    @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriKhaoSatPheDuyet)
                                                                </td>
                                                            }
                                                            @if (Model.KhaoSats.Any(k => k.GiaTriThamDinhPheDuyet != null))
