                                    <div class="table-responsive">
                                        <table class="table table-bordered table-hover table-striped w-100 dt-basic-example">
                                            <thead class="bg-warning-200 text-center">
                                                <tr>
                                                    <th></th>
                                                    @if (Model.GiamSatThiCongs.Any(g => g.GiaTriHopDong != null))
                                                    {
                                                        <th>Giá trị hợp đồng</th>
                                                    }
                                                    @if (Model.GiamSatThiCongs.Any(g => g.GiaTriPLHopDong != null))
                                                    {
                                                        <th>Giá trị phụ lục hợp đồng</th>
                                                    }
                                                    @if (Model.GiamSatThiCongs.Any(g => g.LandVolumeContract != null))
                                                    {
                                                        <th>Khối lượng theo Hợp đồng (trên cạn)</th>
                                                    }
                                                    @if (Model.GiamSatThiCongs.Any(g => g.WaterVolumeContract != null))
                                                    {
                                                        <th>Khối lượng theo Hợp đồng (dưới nước)</th>
