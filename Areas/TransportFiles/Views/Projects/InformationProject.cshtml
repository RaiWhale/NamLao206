                                                        <td>
                                                            <div class="d-flex align-items-center list-action">
                                                                <a class="btn btn-info waves-effect waves-themed bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Sửa"
                                                                   href="@Url.Action("Edit", "Khaosats", new { id = item.Id, projectID = Model.Id })"><i class="sa sa-wrench"></i></a>
                                                                <a class="btn btn-danger  bg-warning mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Xóa"
                                                                   href="@Url.Action("Delete", "Khaosats", new { id = item.Id, projectID = Model.Id })"><i class="sa sa-trash"></i></a>
                                                            </div>
                                                        </td>
                                                        @if (Model.KhaoSats.Any(k => k.GiaTriHopDong != null))
                                                        {
                                                            <td>
                                                                @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriHopDong)
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.GiaTriPLHopDong != null))
                                                        {
                                                            <td>
                                                                @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriPLHopDong)
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.GiaTriDuToan != null))
                                                        {
                                                            <td>
                                                                @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriDuToan)
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.GiaTriKhaoSat != null))
                                                        {
                                                            <td>
                                                                @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriKhaoSat)
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.GiaTriThamDinh != null))
                                                        {
                                                            <td>
                                                                @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriThamDinh)
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.GiaTriDuToanPheDuyet != null))
                                                        {
                                                            <td>
                                                                @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriDuToanPheDuyet)
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.GiaTriKhaoSatPheDuyet != null))
                                                        {
                                                            <td>
                                                                @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriKhaoSatPheDuyet)
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.GiaTriThamDinhPheDuyet != null))
                                                        {
                                                            <td>
                                                                @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.GiaTriThamDinhPheDuyet)
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.KetQuaKhaoSat != null))
                                                        {
                                                            <td>
                                                                @item.KetQuaKhaoSat
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.ChiPhiGiamSat != null))
                                                        {
                                                            <td>
                                                                @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:#,##0} VNĐ", item.ChiPhiGiamSat)
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.LandArea != null))
                                                        {
                                                            <td>
                                                                @item.LandArea @item.Unit.UnitName
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.WaterArea != null))
                                                        {
                                                            <td>
                                                                @item.WaterArea @item.Unit.UnitName
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.LandAreaKhaoSat != null))
                                                        {
                                                            <td>
                                                                @item.LandAreaKhaoSat @item.Unit.UnitName
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.WaterAreaKhaoSat != null))
                                                        {
                                                            <td>
                                                                @item.WaterAreaKhaoSat @item.Unit.UnitName
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.NguoiGiamSat != null))
                                                        {
                                                            <td>
                                                                @item.NguoiGiamSat
                                                            </td>
                                                        }

                                                        <td>
                                                            @(item.TinhTrangCongNo ? "Có" : "Không")
                                                        </td>

                                                        @if (Model.KhaoSats.Any(k => k.Note != null))
                                                        {
                                                            <td>
                                                                @item.Note
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.DocumentType != null))
                                                        {
                                                            <td>
                                                                @item.DocumentType.DocumentTypeName
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.Supplier != null))
                                                        {
                                                            <td>
                                                                @item.Supplier.SupplierName
                                                            </td>
                                                        }
                                                        @if (Model.KhaoSats.Any(k => k.StatusProject != null))
                                                        {
                                                            <td>
                                                                @item.StatusProject.StatusName
                                                            </td>
                                                        }

                                                    </tr>
                                                }
                                            }
                                                </tbody>
                                            </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (Model.GiamSatThiCongs != null && Model.GiamSatThiCongs.Any())
            {
                <div class="col-lg-12 col-sm-12 col-xs-12 ">
                    <div id="panel-1" class="panel panel-icon">
                        <div class="panel-hdr">
                            <h2>
                                Quản lý <span class="fw-300"><i>giám sát</i></span>
                            </h2>
                            <div class="panel-toolbar">
                                <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                                    <svg class="sa-icon">
                                        <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                                        <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                                    </svg>
                                </button>
                                <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
