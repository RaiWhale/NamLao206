                                                            }
                                                            @if (Model.KhaoSats.Any(k => k.DocumentType != null))
                                                            {
                                                                <td>
                                                                    @item.DocumentType.DocumentTypeName
                                                                </td>
                                                            }
                                                            @if (Model.KhaoSats.Any(k => k.Supplier != null))
                                                            {
                                                                <td>
                                                                    @item.Supplier.SupplierName
                                                                </td>
                                                            }
                                                            @if (Model.KhaoSats.Any(k => k.StatusProject != null))
                                                            {
                                                                <td>
                                                                    @item.StatusProject.StatusName
                                                                </td>
                                                            }
                                                            <td>
                                                                <div class="d-flex align-items-center list-action">
                                                                    <a class="badge bg-success mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Sửa"
                                                                       href="@Url.Action(Model.DM_DonVis?.EditBranch ?? "Edit", "Khaosats", new { id = item.Id, projectID = Model.Id })"><i class="ni ni-wrench fa-2x"></i></a>
                                                                    <a class="badge bg-warning mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Xóa"
                                                                       href="@Url.Action("Delete", "Khaosats", new { id = item.Id, projectID = Model.Id })"><i class="ni ni-trash fa-2x"></i></a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
