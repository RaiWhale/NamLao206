@model NamLao206.Models.Project
@using NamLao206.Models;

@{

}
@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)
    <!-- Hiển thị thông báo (nếu có) -->
    <div id="alert-container" data-message="@Html.Raw(HttpUtility.HtmlEncode(ViewBag.Message))"></div>
    <div class="row">
        <div class="col-lg-12 col-sm-12 col-xs-12">
            <div id="panel-1" class="panel panel-icon">
                <div class="panel-hdr">
                    <h2 style="font-size: 15px">
                        Tạo mới <span class="fw-300"><i><b class="color-success-900">và tìm kiếm dự án</b></i></span>
                    </h2>
                    <div class="panel-toolbar">
                        <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                            <svg class="sa-icon">
                                <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                                <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                            </svg>
                        </button>
                        <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
                            <svg class="sa-icon">
                                <use href="~/Content/smartadminNew/icons/sprite.svg#stop-circle"></use>
                            </svg>
                        </button>
                        <button type="button" class="btn btn-panel" data-action="panel-close" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Close">
                            <svg class="sa-icon">
                                <use href="~/Content/smartadminNew/icons/sprite.svg#x-circle"></use>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="panel-container show">
                    <div class="panel-content">
                        @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            <div class="frame-wrap">
                                <div class="demo">
                                    <a href="@Url.Action("Create","Khaosats", new {projectID = Model.Id})" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                        <span class="fal fa-download mr-1"></span>Khảo sát
                                    </a>
                                    <a href="@Url.Action("Create","GiamSatThiCongs",new {projectID = Model.Id})" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                        <span class="fal fa-download mr-1"></span>Giám sát
                                    </a>
                                    <a href="@Url.Action("Create","ThiCongs",new {projectID = Model.Id})" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                        <span class="fal fa-download mr-1"></span>Thi công
                                    </a>
                                    <a href="@Url.Action("Create","NghiemThus", new {projectID = Model.Id})" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                        <span class="fal fa-vote-yea mr-1"></span>Nghiệm thu
                                    </a>
                                    <a href="@Url.Action("Create","HoSoPhapLies",new {projectID = Model.Id})" class="bcommand btn btn-md btn-primary waves-effect waves-themed">
                                        <span class="fal fa-folder mr-1"></span>Hồ sơ pháp lý
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">

            @if (Model.KhaoSats != null && Model.KhaoSats.Any())
            {
                <div class="col-lg-12 col-sm-12 col-xs-12 ">
                    <div id="panel-1" class="panel panel-icon">
                        <div class="panel-hdr">
                            <h2>
                                Quản lý <span class="fw-300"><i>khảo sát</i></span>
                            </h2>
                            <div class="panel-toolbar">
                                <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                                    <svg class="sa-icon">
                                        <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                                        <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                                    </svg>
                                </button>
                                <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
