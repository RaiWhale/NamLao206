                                                    {
                                                        <th>Giá trị dự toán phê duyệt</th>
                                                    }
                                                    @if (Model.KhaoSats.Any(k => k.GiaTriKhaoSatPheDuyet != null))
                                                    {
                                                        <th>Giá trị khảo sát phê duyệt</th>
