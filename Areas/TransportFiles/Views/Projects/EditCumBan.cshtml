@model NamLao206.Models.Project

@{

}



@using (Html.BeginForm("Edit", "Projects", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.CreateDate)
        @Html.HiddenFor(model => model.CreateUserId)
        @Html.HiddenFor(model => model.IsActive)
        <div class="row">
            <div class="col-lg-6 col-sm-9 col-xs-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.TenDuAn, "Tên dự án", htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TenDuAn, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                        @Html.ValidationMessageFor(model => model.TenDuAn, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-sm-9 col-xs-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.MaDuAn, "Mã dự án", htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.MaDuAn, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                        @Html.ValidationMessageFor(model => model.MaDuAn, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-sm-9 col-xs-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.DonViId, "Đơn vị", htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.DonViId, null, htmlAttributes: new { @class = "js-states form-control select2", @required = "required" })
                        @Html.ValidationMessageFor(model => model.DonViId, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-sm-9 col-xs-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.InvestorId, "Chủ đầu tư", htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.InvestorId, null, "-- Chọn --", htmlAttributes: new { @class = "js-states form-control select2", @required = "required" })
                        @Html.ValidationMessageFor(model => model.TinhId, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-sm-9 col-xs-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.ProjectValue, "Tổng giá trị", htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.ProjectValue, new { htmlAttributes = new { @class = "form-control ", @type = "number", @required = "required" } })
                        @Html.ValidationMessageFor(model => model.ProjectValue, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-sm-9 col-xs-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.GiamSat, "Người phê duyệt", htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.GiamSat, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.GiamSat, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-sm-9 col-xs-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.StartDate, "Ngày bắt đầu", htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="col-md-10">
                        <input type="datetime-local" class="form-control" data-lang="en" data-RTL="false" id="StartDate" name="StartDate" data-date-autoclose="true" value="@Model.StartDate.Value.ToString("s")" />
                        @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-sm-9 col-xs-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.TinhTrangDuAn, "Tình trạng dự án", htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.TinhTrangDuAn, null, "-- Tình trạng --", htmlAttributes: new { @class = "js-states form-control select2" })
                        @Html.ValidationMessageFor(model => model.TinhTrangDuAn, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="col-lg-12 col-sm-12 col-xs-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.Note, "Ghi chú", htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Note, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group" style="float:right">
            <button type="submit" class="mt-2 btn btn-success">Lưu</button>
            <button type="button" class="mt-2 btn btn-light" data-bs-dismiss="modal">Đóng</button>
        </div>
    </div>
}

