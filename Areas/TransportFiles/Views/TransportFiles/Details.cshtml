@model NamLao206.Models.TransportFile

@{
    ViewBag.Title = "Chi tiết - ";
    var summernote = ViewBag.Note;
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="container" style="margin-top:20px">
        <div class="col-lg-12 col-sm-12 col-xs-12 ">
            <div id="panel-1" class="panel">
                <div class="panel-hdr">
                    <h2>
                        Số văn bản:<span class="fw-300"><i>@Html.DisplayFor(model => model.tenFile)</i></span>
                    </h2>
                </div>
                <div class="panel-container show">
                    <div class="panel-content">
                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <!-- Hiển thị thông báo (nếu có) -->
                            @if (!string.IsNullOrEmpty(@ViewBag.Message))
                            {
                                <div class="alert alert-danger">
                                    @ViewBag.Message
                                </div>
                            }
                            @Html.HiddenFor(model => model.Id)
                            <ul id="js-emails" class="notification notification-layout-2">
                                <li>
                                    <div class="d-flex align-items-center px-3 px-sm-4 px-lg-5 py-1 py-lg-0 height-4 height-mobile-auto">
                                        <a href="#" title="@(Model.KhanCap == true ? "starred" : "Not starred")" class="d-flex align-items-center py-1 ml-2 mt-4 mt-lg-0 ml-lg-0 mr-lg-4 fs-lg color-warning-500 order-3 order-lg-2"><i class="fas fa-star"></i></a>
                                        <div class="d-flex flex-row flex-wrap flex-1 align-items-stretch align-self-stretch order-2 order-lg-3">
                                            <div class="row w-100">
                                                <div class="name d-flex width-sm align-items-center pt-1 pb-0 py-lg-1 col-12 col-lg-auto">
                                                    @Html.DisplayFor(model => model.Account1.Employee.Name) -  @Html.DisplayFor(model => model.Account1.Employee.DM_PhongBans.TenKhoa)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="fs-sm text-muted ml-auto hide-on-hover-parent order-4 position-on-mobile-absolute pos-top pos-right mt-2 mr-3 mr-sm-4 mt-lg-0 mr-lg-0">
                                            Người phê duyệt: @Model.Account2.Employee.Name --
                                            @if (Model.CreateDate.Date != DateTime.Today)
                                            {
                                                @Model.CreateDate.ToString("dd/MM/yyyy HH:mm:ss")
                                            }
                                            else
                                            {
                                                @Model.CreateDate.ToString("HH:mm:ss")
                                            }
                                        </div>
                                    </div>
                                </li>
                            </ul>
                            <div>
                                <div class="row">
                                    <div class="col-lg-12 col-sm-12 col-xs-12 form-group">
                                        @Html.Label("Người nhận", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-12">
                                            @Html.TextBox("NguoiNhan", ViewBag.NguoiNhan as string, new { @class = "form-control is-invalid-cus", @readonly = "readonly" })
                                            @Html.ValidationMessageFor(model => model.Mota, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <div class="row">
                                        <div class="col-lg-12 col-sm-12 col-xs-12 form-group">
                                            @Html.Label("Trích Yếu", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.Mota, new { htmlAttributes = new { @class = "form-control is-invalid-cus", @readonly = "readonly" } })
                                                @Html.ValidationMessageFor(model => model.Mota, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="col-lg-12 col-sm-12 col-xs-12 form-group">
                                            @Html.Label("Tin nhắn", htmlAttributes: new { @class = "control-label col-md-3" })
                                            <div class="col-md-12">
                                                <textarea class="js-summernote" name="Note" id="Note">@Html.Raw(ViewBag.Note ?? "")</textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="card col-md-12 col-xs-12">
                                            <div class="card-header justify-content-between">
                                                <div class="header-title">
                                                    <h4 class="card-title">Nơi nhận qua mạng</h4>
                                                </div>
                                            </div>
                                            <div class="card-body text-center">
                                                <div class="custom-control custom-radio custom-radio-color-checked custom-control-inline">
                                                    <input type="radio" id="customRadio-1" name="customRadio_10" class="custom-control-input bg-primary" value="option1">
                                                    <label class="custom-control-label" for="customRadio-1"> Gửi cá nhân </label>
                                                </div>
                                                <div class="custom-control custom-radio custom-radio-color-checked custom-control-inline">
                                                    <input type="radio" id="customRadio-2" name="customRadio_10" class="custom-control-input bg-success" value="option2">
                                                    <label class="custom-control-label" for="customRadio-2"> Gửi phòng ban </label>
                                                </div>
                                                <div class="custom-control custom-radio custom-radio-color-checked custom-control-inline">
                                                    <input type="radio" id="customRadio-3" name="customRadio_10" class="custom-control-input bg-danger" value="option3">
                                                    <label class="custom-control-label" for="customRadio-3"> Gửi đơn vị </label>
                                                </div>

                                            </div>
                                            <!--Sửa JS app.js -> js -> assets -> AdminBinhLt (multiple)-->
                                            <div class="row card-body align-content-center">
                                                <div class="col-md-6" id="dropdown1">
                                                    <div class="form-group">
                                                        @Html.Label("Chọn người gửi", htmlAttributes: new { @class = "control-label col-md-6" })
                                                        <div class="col-md-9">
                                                            @Html.DropDownList("lstReceiverUserId", (SelectList)ViewBag.Employees, htmlAttributes: new { @class = "js-states form-control select2", @multiple = "multiple", @id = "lstReceiverUserId" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6" id="dropdown2">
                                                    <div class="form-group">
                                                        @Html.Label("Chọn phòng gửi", htmlAttributes: new { @class = "control-label col-md-6" })
                                                        <div class="col-md-9">
                                                            @Html.DropDownList("lstReceiverRoomId", (SelectList)ViewBag.DM_PhongBans, htmlAttributes: new { @class = "js-states form-control select2", @multiple = "multiple", @id = "lstReceiverRoomId" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6" id="dropdown3">
                                                    <div class="form-group">
                                                        @Html.Label("Chọn đơn vị gửi", htmlAttributes: new { @class = "control-label col-md-6" })
                                                        <div class="col-md-9">
                                                            @Html.DropDownList("lstReceiverUnitId", (SelectList)ViewBag.DM_DonVis, htmlAttributes: new { @class = "js-states form-control select2", @multiple = "multiple", @id = "lstReceiverUnitId" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div style="float:right">
                                        <button type="submit" class="mt-2 btn btn-success">Chuyển tiếp</button>
                                        <button type="button" class="mt-2 btn btn-light" data-dismiss="modal">Đóng</button>
                                    </div>
                                    @*<a class="btn btn-primary mt-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Chuyển tiếp"
                                        href="@Url.Action("ChuyenTiep", new { id = Model.Id })"><i class="ri-eye-line mr-0">Chuyển tiếp</i></a>*@
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover table-striped w-100 dt-basic-example">
                                        <thead class="bg-warning-200 text-center">
                                            <tr>
                                                <th>STT</th>
                                                <th>TÊN VĂN BẢN</th>
                                                <th>DOWLOAD</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.TransportFileUrls)
                                            {
                                                <tr>
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.Id)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Url)
                                                    </td>
                                                    <td class="text-center">
                                                        <a href="~/Uploads/HopThu/@item.TransportFilesId/@item.Url">Tải về</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
