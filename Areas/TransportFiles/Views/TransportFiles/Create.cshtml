@model NamLao206.Models.TransportFile

@{
    ViewBag.Title = "Create";
}


@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="main-content">
        <div class="row">
            <div class="col-xl-12">

                <div id="panel-1" class="panel panel-icon">
                    <div class="panel-hdr">
                        <h2>
                            Gửi<span class="fw-300"><i>thư</i></span>
                        </h2>
                        <div class="panel-toolbar">
                            <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                                <svg class="sa-icon">
                                    <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                                    <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                                </svg>
                            </button>
                            <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
                                <svg class="sa-icon">
                                    <use href="~/Content/smartadminNew/icons/sprite.svg#stop-circle"></use>
                                </svg>
                            </button>
                            <button type="button" class="btn btn-panel" data-action="panel-close" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Close">
                                <svg class="sa-icon">
                                    <use href="~/Content/smartadminNew/icons/sprite.svg#x-circle"></use>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="panel-container show">
                        <div class="panel-content">
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <!-- Hiển thị thông báo (nếu có) -->
                                @if (!string.IsNullOrEmpty(@ViewBag.Message))
                                {
                                    <div class="alert alert-danger">
                                        @ViewBag.Message
                                    </div>
                                }

                                <div class="row">
                                    <div class="col-lg-4 col-sm-8 col-xs-12 form-group">
                                        @Html.Label("Số Văn Bản", htmlAttributes: new { @class = "control-label col-md-9" })
                                        <div class="col-md-12">
                                            @Html.EditorFor(model => model.tenFile, new { htmlAttributes = new { @class = "form-control is-invalid-cus", required = "required" } })
                                            @Html.ValidationMessageFor(model => model.tenFile, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-sm-8  col-xs-12 form-group">
                                        @Html.Label("Ngày ban hành", htmlAttributes: new { @class = "control-label col-md-9" })
                                        <input type="datetime-local" class="form-control" data-lang="en" data-RTL="false" id="NgayBanHanh" name="NgayBanHanh" value="@DateTime.Now.ToString("s")" />
                                    </div>
                                    <div class="col-lg-4 col-sm-8 col-xs-12 form-group">
                                        @Html.Label("Người phê duyệt", htmlAttributes: new { @class = "control-label col-md-9" })
                                        <div class="col-md-12">
                                            @Html.DropDownListFor(model => model.NguoiPheDuyetId, (SelectList)ViewBag.Employees, htmlAttributes: new { @class = "js-states form-control select2", @id = "NguoiPheDuyetId" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12 col-sm-12 col-xs-12 form-group">
                                        @Html.Label("Trích Yếu", htmlAttributes: new { @class = "control-label col-md-3" })
                                        <div class="col-md-12">
                                            @Html.EditorFor(model => model.Mota, new { htmlAttributes = new { @class = "form-control is-invalid-cus" } })
                                            @Html.ValidationMessageFor(model => model.Mota, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:20px">
                                    <div class="col-md-3 col-xs-12">
                                        <div class="input-group col-md-12">
                                            <input type="file" class="btn btn-outline-primary rounded-pill mt-2" multiple name="pic" id="pic" placeholder="File" required />
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-xs-12">
                                        <div class="input-group col-md-7">
                                            <div class="input-group-prepend text-center">
                                                <span class="input-group-text" id="basic-addon1">Khẩn cấp</span>
                                            </div>
                                            <input class="form-control" type="checkbox" name="KhanCap" id="KhanCap" value="true" />
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-xs-12">
                                        <div class="input-group col-md-10">
                                            <div class="input-group-prepend text-center">
                                                @Html.Label("Số trang", htmlAttributes: new { @class = "input-group-text" })
                                            </div>
                                            @Html.EditorFor(model => model.SoTrang, new { htmlAttributes = new { @class = "form-control is-invalid-cus", required = "required" } })
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-xs-12">
                                        <div class="input-group col-md-10">
                                            <div class="input-group-prepend text-center">
                                                @Html.Label("Độ mật", htmlAttributes: new { @class = "input-group-text" })
                                            </div>
                                            @Html.EditorFor(model => model.DoMat, new { htmlAttributes = new { @class = "form-control is-invalid-cus", required = "required" } })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-sm-12 col-xs-12 form-group" style="margin-top:20px">
                                        <div class="col-md-12">
                                            <!-- Reply form -->
                                            <div class="" id="mainReplyForm">
                                                <div class="card mb-g border shadow-0">
                                                    <div class="card-header">
                                                        <h5 class="mb-0 fw-bold">Nơi nhận</h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="row">
                                                            <div class="col-md-3 col-xs-6">
                                                                <div class="mb-3">
                                                                    <div class="custom-control custom-radio custom-radio-color-checked custom-control-inline">
                                                                        <input type="radio" id="customRadio-1" name="customRadio_10" class="custom-control-input bg-primary" value="option1">
                                                                        <label class="custom-control-label" for="customRadio-1"> Gửi cá nhân </label>
                                                                    </div>
                                                                </div>
                                                                <div class="mb-3">
                                                                    <div class="custom-control custom-radio custom-radio-color-checked custom-control-inline">
                                                                        <input type="radio" id="customRadio-2" name="customRadio_10" class="custom-control-input bg-success" value="option2">
                                                                        <label class="custom-control-label" for="customRadio-2"> Gửi phòng ban </label>
                                                                    </div>
                                                                </div>
                                                                <div class="mb-3">
                                                                    <div class="custom-control custom-radio custom-radio-color-checked custom-control-inline">
                                                                        <input type="radio" id="customRadio-3" name="customRadio_10" class="custom-control-input bg-danger" value="option3">
                                                                        <label class="custom-control-label" for="customRadio-3"> Gửi đơn vị </label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-9 col-xs-6">
                                                                <div class="" id="dropdown1">
                                                                    <div class="form-group">
                                                                        @Html.Label("Chọn người gửi", htmlAttributes: new { @class = "control-label col-md-6" })
                                                                        <div class="col-md-9">
                                                                            @Html.DropDownList("lstReceiverUserId", (SelectList)ViewBag.Employees, htmlAttributes: new { @class = "js-states form-control select2", @multiple = "multiple", @id = "lstReceiverUserId" })
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="" id="dropdown2">
                                                                    <div class="form-group">
                                                                        @Html.Label("Chọn phòng gửi", htmlAttributes: new { @class = "control-label col-md-6" })
                                                                        <div class="col-md-9">
                                                                            @Html.DropDownList("lstReceiverRoomId", (SelectList)ViewBag.DM_PhongBans, htmlAttributes: new { @class = "js-states form-control select2", @multiple = "multiple", @id = "lstReceiverRoomId" })
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="" id="dropdown3">
                                                                    <div class="form-group">
                                                                        @Html.Label("Chọn đơn vị gửi", htmlAttributes: new { @class = "control-label col-md-6" })
                                                                        <div class="col-md-9">
                                                                            @Html.DropDownList("lstReceiverUnitId", (SelectList)ViewBag.DM_DonVis, htmlAttributes: new { @class = "js-states form-control select2", @multiple = "multiple", @id = "lstReceiverUnitId" })
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row card-body align-content-center">

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-sm-12 col-xs-12 form-group" style="margin-top:20px">
                                    <div class="col-md-12">
                                        <!-- Reply form -->
                                        <div class="" id="mainReplyForm">
                                            <div class="card mb-g border shadow-0">
                                                <div class="card-header">
                                                    <h5 class="mb-0 fw-bold">Tin nhắn</h5>
                                                </div>
                                                <div class="card-body">
                                                    @*<div class="row mb-3">
                <div class="col-lg-8">
                    <div class="d-flex mb-2">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm"><i class="fal fa-bold"></i></button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"><i class="fal fa-italic"></i></button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"><i class="fal fa-underline"></i></button>
                        </div>
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm"><i class="fal fa-list-ul"></i></button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"><i class="fal fa-list-ol"></i></button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"><i class="fal fa-link"></i></button>
                        </div>
                    </div>
                </div>
            </div>*@
                                                    <div class="mb-3">
                                                        <textarea name="Note" id="Note" class="form-control" rows="6" placeholder="Type your reply here..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-end align-items-center">
                                                    <button type="submit" class="mt-2 btn btn-success">GỬI VĂN BẢN</button>
                                                    <button type="button" class="mt-2 btn btn-light" data-dismiss="modal">Đóng</button>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- End Reply form -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
