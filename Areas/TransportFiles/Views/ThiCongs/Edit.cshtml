                    @Html.LabelFor(model => model.TinhTrangCongNo, "Công nợ", htmlAttributes: new { @class = "control-label col-md-6" })
                    <div class="col-md-10">
                        <input class="form-check-label" type="checkbox" name="TinhTrangCongNo" id="TinhTrangCongNo" value="true" />
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="col-lg-6 col-sm-9 col-xs-12">
        <div class="form-group"  >
            <button type="submit" class="mt-2 btn btn-success">Lưu</button>
            <button type="button" class="mt-2 btn btn-light" data-bs-dismiss="modal">Đóng</button>
        </div>
    </div>
</div>
    }


