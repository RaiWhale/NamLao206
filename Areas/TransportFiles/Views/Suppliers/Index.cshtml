@model IEnumerable<NamLao206.Models.Supplier>

@{

}

@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div id="alert-container" data-message="@Html.Raw(HttpUtility.HtmlEncode(ViewBag.Message))"></div>
    <div class="row">
        <div class="col-lg-4 col-sm-8 col-xs-12">
            <div id="panel-1" class="panel panel-icon">
                <div class="panel-hdr">
                    <h2 style="font-size: 150%">
                        Tạo mới <span class="fw-300"><i><b class="color-success-900">và tìm kiếm dự án</b></i></span>
                    </h2>
                    <div class="panel-toolbar">
                        <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                            <svg class="sa-icon">
                                <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                                <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                            </svg>
                        </button>
                        <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
                            <svg class="sa-icon">
                                <use href="~/Content/smartadminNew/icons/sprite.svg#stop-circle"></use>
                            </svg>
                        </button>
                        <button type="button" class="btn btn-panel" data-action="panel-close" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Close">
                            <svg class="sa-icon">
                                <use href="~/Content/smartadminNew/icons/sprite.svg#x-circle"></use>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="panel-container show">
                    <div class="panel-content">
                        @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            <div class="frame-wrap">
                                <div class="demo">
                                    <a href="@Url.Action("Create")" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                        <span class="fal fa-download mr-1"></span>Tạo mới
                                    </a>
                                    <input type="text" name="search" class="search form-control" placeholder="Tìm kiếm" value="@ViewBag.search">

                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 col-sm-12 col-xs-12 ">
            <div id="panel-1" class="panel panel-icon">
                <div class="panel-hdr">
                    <h2>
                        Nhà<span class="fw-300"><i>cung cấp</i></span>
                    </h2>
                    <div class="panel-toolbar">
                        <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                            <svg class="sa-icon">
                                <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                                <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                            </svg>
                        </button>
                        <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
                            <svg class="sa-icon">
                                <use href="~/Content/smartadminNew/icons/sprite.svg#stop-circle"></use>
                            </svg>
                        </button>
                        <button type="button" class="btn btn-panel" data-action="panel-close" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Close">
                            <svg class="sa-icon">
                                <use href="~/Content/smartadminNew/icons/sprite.svg#x-circle"></use>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="panel-container show">
                    <div class="panel-content">
                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover table-striped w-100 dt-basic-example" style="font-size: 15px">
                                    <thead class="bg-warning-200 text-center">
                                        <tr>
                                            <th>
                                                Tên đơn vị
                                            </th>
                                            <th>
                                                Địa chỉ
                                            </th>
                                            <th>
                                                Số điện thoại
                                            </th>
                                            <th>
                                                Người đại diện
                                            </th>

                                            <th>
                                                @Html.DisplayNameFor(model => model.Note)
                                            </th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.SupplierName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Address)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Phone)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.NguoiDaiDien)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Note)
                                                </td>
                                                <td style="width:120px">
                                                    <a class="btn btn-info waves-effect waves-themed bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Sửa"
                                                       href="@Url.Action("Edit", new { id = item.Id })"><i class="sa sa-wrench"></i></a>
                                                    <a class="btn btn-danger  bg-warning mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Xóa"
                                                       href="@Url.Action("Delete", new { id = item.Id })"><i class="sa sa-trash"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}


