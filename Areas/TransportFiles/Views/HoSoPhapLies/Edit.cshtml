@model NamLao206.Models.HoSoPhapLy

@{
    ViewBag.Title = "Lưu trữ hồ sơ";
}


@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.CreateUserId)
    @Html.HiddenFor(model => model.CreateDate)
    @Html.HiddenFor(model => model.IsActive)
    @Html.AntiForgeryToken()
    <div class="panel-body">
        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="row">
                <div class="col-lg-6 col-sm-9 col-xs-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DocumentTypeId, "Loại văn bản", htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-10">
                            @Html.DropDownList("DocumentTypeId", null, htmlAttributes: new { @class = "form-control select2" })
                            @Html.ValidationMessageFor(model => model.DocumentTypeId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-sm-9 col-xs-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.ProjectID, "ProjectID", htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-10">
                            @Html.DropDownList("ProjectID", null, htmlAttributes: new { @class = "form-control select2" })
                            @Html.ValidationMessageFor(model => model.ProjectID, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-sm-9 col-xs-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.AddBangId, "Bảng lưu trữ", htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-10">
                            @Html.DropDownList("AddBangId", null, htmlAttributes: new { @class = "form-control select2" })
                            @Html.ValidationMessageFor(model => model.AddBangId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-sm-9 col-xs-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.TenHoSo, "Tên tài liệu", htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.TenHoSo, new { htmlAttributes = new { @class = "form-control is-invalid-cus", @placeholder = "Tên tài liệu", required = "required" } })
                            @Html.ValidationMessageFor(model => model.TenHoSo, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-sm-9 col-xs-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Note, "Ghi chú", htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Note, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-sm-9 col-xs-12">
                    <div class="form-group">
                        @Html.Label("Tải file", htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-10">
                            <input type="file" class="btn btn-outline-primary rounded-pill mt-2 is-invalid-cus" name="file" id="file" placeholder="Tải file" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-sm-9 col-xs-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.IsActive, "Trạng thái", htmlAttributes: new { @class = "control-label col-md-10" })
                        <div class="col-md-10">
                            <div class="checkbox form-check-label">
                                @Html.EditorFor(model => model.IsActive, "", new { @class = "form-check-label" })
                                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div  >
                <button type="submit" class="mt-2 btn btn-success">Lưu</button>
                <button type="button" class="mt-2 btn btn-light" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>       
    </div>
}