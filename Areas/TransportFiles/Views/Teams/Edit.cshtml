@model NamLao206.Models.Team

@{
 
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.CreateDate)
    @Html.HiddenFor(model => model.CreateUserId)
    @Html.HiddenFor(model => model.DonviId)
    <div class="row">
        <div class="col-lg-6 col-sm-9 col-xs-12">
            <div class="form-group">
                @Html.LabelFor(model => model.TeamName, "Tên đội", htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.TeamName, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                    @Html.ValidationMessageFor(model => model.TeamName, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-sm-9 col-xs-12">
            <div class="form-group">
                @Html.LabelFor(model => model.NguoiDaiDien, "Người đại diện", htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.NguoiDaiDien, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                    @Html.ValidationMessageFor(model => model.NguoiDaiDien, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-sm-9 col-xs-12">
            <div class="form-group">
                @Html.LabelFor(model => model.SoLuongNguoi, "Số lượng người", htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.SoLuongNguoi, new { htmlAttributes = new { @class = "form-control", @type = "number", @required = "required" } })
                    @Html.ValidationMessageFor(model => model.SoLuongNguoi, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-sm-9 col-xs-12">
            <div class="form-group">
                @Html.LabelFor(model => model.Note, "Ghi chú", htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Note, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-sm-9 col-xs-12">
            <div class="form-group">
                @Html.LabelFor(model => model.IsActive, "Trạng thái", htmlAttributes: new { @class = "control-label col-md-6" })
                <div class="input-group col-md-7">
                    <div class="input-group-prepend text-center">
                        <span class="input-group-text" id="basic-addon1">Kích hoạt</span>
                    </div>
                    <input class="form-check-label" type="checkbox" name="isActive" id="isActive" value="true" checked="@Model.IsActive" />
                </div>
            </div>
        </div>
    </div>
    <div class="form-group" style="float:right">
        <button type="submit" class="mt-2 btn btn-success">Lưu</button>
        <button type="button" class="mt-2 btn btn-light" data-bs-dismiss="modal">Đóng</button>
    </div>
</div>
}

