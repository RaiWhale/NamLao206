@using NamLao206.Models
@using NamLao206.Services
@{
    Layout = null;
    namlao206_websiteEntities db = new namlao206_websiteEntities();
    Account acc = null;
    List<Transport> ThuChuaXem = null;
    List<MenuItem> userMenu = null;
    string userDepartmentName = "";
    int userDepartmentId = 0;
    if (User.Identity.IsAuthenticated)
    {
        acc = db.Accounts.Where(x => x.Id.ToString().Equals(User.Identity.Name)).SingleOrDefault();
        if (acc != null && acc.LevelId != 3)
        {
            ThuChuaXem = db.Transports.Where(x => x.ReceiverUserId == acc.EmployeeId && x.DaXem == false)
                .OrderByDescending(x => x.TransportDate).ToList();
            // Load menu động THEO ĐƠN VỊ của user
            var permissionService = new PermissionService(db);

            userDepartmentId = permissionService.GetUserDepartment(acc.Id);
            userDepartmentName = permissionService.GetUserFullDepartmentInfo(acc.Id);
            userMenu = permissionService.GetUserMenuByUserDepartment(acc.Id);

            // Lưu thông tin department vào ViewBag để sử dụng trong view
            ViewBag.UserDepartmentId = userDepartmentId;
            ViewBag.UserDepartmentName = userDepartmentName;
        }
        else
        {
            // Gọi hàm Logout()
            Response.Redirect(Url.Action("Logout", "Login", new { area = "" }));
        }
    }
}
