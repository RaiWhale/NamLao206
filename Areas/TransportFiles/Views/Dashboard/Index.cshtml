@using NamLao206.Models;
@{
    var projects = ViewBag.Projects as IEnumerable<Project>;
    var Donvi = ViewBag.Donvi as DM_DonVis;
}

<div class="row" id="topInformation">

</div>
<div class="row">
    <div class="col-lg-3 col-sm-6 col-xs-12">
        @*<div id="panel-4" class="panel panel-locked" style="height:auto" data-panel-sortable data-panel-collapsed data-panel-close>*@
        <div id="panel-1" class="panel panel-icon">
            <div class="panel-hdr">
                <h2>
                    Tình hình <span class="fw-300"><i><b class="color-success-900">dự án</b></i></span>
                </h2>
                <div class="panel-toolbar">
                    <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                        <svg class="sa-icon">
                            <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                            <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                        </svg>
                    </button>
                    <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
                        <svg class="sa-icon">
                            <use href="~/Content/smartadminNew/icons/sprite.svg#stop-circle"></use>
                        </svg>
                    </button>
                    <button type="button" class="btn btn-panel" data-action="panel-close" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Close">
                        <svg class="sa-icon">
                            <use href="~/Content/smartadminNew/icons/sprite.svg#x-circle"></use>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="panel-container show">
                <div class="panel-content">
                    <div id="pieChart" style="height:350px !important;">
                        <canvas style="height:auto !important;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5 col-sm-9 col-xs-12">
        <div id="panel-1" class="panel panel-icon">
            <div class="panel-hdr">
                <h2>
                    Tăng trưởng <span class="fw-300"><i><b class="color-success-900">doanh thu</b></i></span>
                </h2>
                <div class="panel-toolbar">
                    <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                        <svg class="sa-icon">
                            <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                            <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                        </svg>
                    </button>
                    <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
                        <svg class="sa-icon">
                            <use href="~/Content/smartadminNew/icons/sprite.svg#stop-circle"></use>
                        </svg>
                    </button>
                    <button type="button" class="btn btn-panel" data-action="panel-close" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Close">
                        <svg class="sa-icon">
                            <use href="~/Content/smartadminNew/icons/sprite.svg#x-circle"></use>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="panel-container show">
                <div class="panel-content poisition-relative">
                    <!-- Canvas cho biểu đồ -->
                    <canvas id="myLineChart" style="height:350px !important;"></canvas>
                    <!-- datatable end-->
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-sm-8 col-xs-12">
        <div id="panel-1" class="panel panel-icon">
            <div class="panel-hdr">
                <h2>
                    Thống kê <span class="fw-300"><i><b class="color-success-900">nhân sự</b></i></span>
                </h2>
                <div class="panel-toolbar">
                    <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                        <svg class="sa-icon">
                            <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                            <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                        </svg>
                    </button>
                    <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
                        <svg class="sa-icon">
                            <use href="~/Content/smartadminNew/icons/sprite.svg#stop-circle"></use>
                        </svg>
                    </button>
                    <button type="button" class="btn btn-panel" data-action="panel-close" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Close">
                        <svg class="sa-icon">
                            <use href="~/Content/smartadminNew/icons/sprite.svg#x-circle"></use>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="panel-container show">
                <div class="panel-content poisition-relative border-faded border-left-0 border-right-0 border-top-0">
                    <div class="row no-gutters" id="nhanSuChart">

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">

        <div class="col-lg-8 col-sm-10 col-xs-12 ">
            <div id="panel-1" class="panel panel-icon">
                <div class="panel-hdr">
                    <h2>
                        Dự <span class="fw-300"><i><b class="color-success-900">Án</b></i></span>
                    </h2>
                    <div class="panel-toolbar">
                        <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                            <svg class="sa-icon">
                                <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                                <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                            </svg>
                        </button>
                        <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
                            <svg class="sa-icon">
                                <use href="~/Content/smartadminNew/icons/sprite.svg#stop-circle"></use>
                            </svg>
                        </button>
                        <button type="button" class="btn btn-panel" data-action="panel-close" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Close">
                            <svg class="sa-icon">
                                <use href="~/Content/smartadminNew/icons/sprite.svg#x-circle"></use>
                            </svg>
                        </button>
                    </div>
                    <a href="@Url.Action("Create","Projects")" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                        <span class="fal fa-download mr-1"></span>Tạo mới
                    </a>
                </div>
                <div class="panel-container show">
                    <div class="panel-content">
                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover table-striped w-100 dt-basic-example">
                                    <thead class="bg-warning-200 text-center">
                                        <tr>
                                            <th>
                                                Mã dự án
                                            </th>
                                            <th>
                                                Tên dự án
                                            </th>
                                            <th>
                                                Giám sát
                                            </th>
                                            @*<th>
                                                Ngày bắt đầu
                                            </th>*@
                                            @*<th>
                                                    Ngày kết thúc
                                                </th>*@
                                            @*<th>
                                                Công nợ
                                            </th>*@
                                            <th>
                                                Đơn vị
                                            </th>
                                            <th>
                                                Chủ đầu tư
                                            </th>
                                            <th>
                                                Tình trạng
                                            </th>
                                            <th  style="width:100px"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in projects)
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@Url.Action("InformationProject", new { projectID = item.Id })">
                                                        @Html.DisplayFor(modelItem => item.MaDuAn)
                                                    </a>
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("InformationProject", new { projectID = item.Id })" style="text-decoration: underline;">
                                                        @Html.DisplayFor(modelItem => item.TenDuAn)
                                                    </a>
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.GiamSat)
                                                </td>
                                                @*<td>
                                                    @Html.DisplayFor(modelItem => item.StartDate)
                                                </td>*@
                                                @*<td>
            @Html.DisplayFor(modelItem => item.EndDate)
        </td>*@
                                                @*<td>
                                                    <input class="form-control" type="checkbox" checked="@item.TinhTrangCongNo" disabled />
                                                </td>*@
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.DM_DonVis.TenDonVi)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Supplier.SupplierName) - @Html.DisplayFor(modelItem => item.Supplier.NguoiDaiDien)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.StatusProject.StatusName)
                                                </td>
                                                <td style="width:100px">
                                                    @*<a class="badge bg-success mr-2" data-toggle="tooltip" data-placement="top" data-title="Chi tiết" data-original-title="Chi tiết"
            href="@Url.Action("InformationProject", new { projectID = item.Id })"><i class="ni ni-wrench fa-2x"></i></a>*@
                                                    <a class="btn btn-info waves-effect waves-themed bcommand" data-toggle="tooltip" data-placement="top" data-title="Sửa" data-original-title="Sửa"
                                                       href="@Url.Action(Donvi.EditBranch ?? "Edit", new { id = item.Id })"><i class="sa sa-wrench"></i></a>
                                                    <a class="btn btn-danger  bg-warning mr-2 bcommand" data-toggle="tooltip" data-placement="top" data-title="Xóa" data-original-title="Xóa"
                                                       href="@Url.Action("Delete", new { id = item.Id })"><i class="sa sa-trash"></i></a>
                                                </td>

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

</div>
<script src="~/Content/smartadmin/js/chartCustomized.js"></script>
<!-- Chart.js -->
