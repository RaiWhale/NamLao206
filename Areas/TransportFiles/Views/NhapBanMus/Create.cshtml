                            @Html.LabelFor(model => model.NguoiPheDuyet_EMP_Id, "Người phê duyệt", new { @class = "control-label" })
                            @Html.DropDownList("NguoiPheDuyet_EMP_Id", null, new { @class = "form-control select2 js-states" })
                            @Html.ValidationMessageFor(model => model.NguoiPheDuyet_EMP_Id, "", new { @class = "text-danger" })
