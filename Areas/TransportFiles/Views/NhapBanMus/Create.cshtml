@model NamLao206.Models.NhapBanMu
@{
}
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" id="createModal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row g-3">
            <!-- g-3: gap tốt hơn cho form -->
            <!-- Các trường chung luôn hiển thị -->
            <div class="col-lg-6 col-md-9">
                <div class="form-group">
                    @Html.LabelFor(model => model.TenPhieu, "Tên dự án", new { @class = "control-label" })
                    @Html.EditorFor(model => model.TenPhieu, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    @Html.ValidationMessageFor(model => model.TenPhieu, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-lg-6 col-md-9">
                <div class="form-group">
                    @Html.LabelFor(model => model.MaPhieu, "Mã dự án", new { @class = "control-label" })
                    @Html.EditorFor(model => model.MaPhieu, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    @Html.ValidationMessageFor(model => model.MaPhieu, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-lg-6 col-md-9">
                <div class="form-group">
                    @Html.LabelFor(model => model.LoaiMu, "Loại mủ", new { @class = "control-label" })
                    @Html.EditorFor(model => model.LoaiMu, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    @Html.ValidationMessageFor(model => model.LoaiMu, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-lg-6 col-md-9">
                <div class="form-group">
                    @Html.LabelFor(model => model.NgayNhap, "Ngày nhập", new { @class = "control-label" })
                    <input type="datetime-local" class="form-control" id="NgayNhap" name="NgayNhap" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    @Html.ValidationMessageFor(model => model.NgayNhap, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-lg-6 col-md-9">
                <div class="form-group">
                    @Html.LabelFor(model => model.Team_Id, "Tên đội", new { @class = "control-label" })
                    @Html.DropDownList("Team_Id", null, new { @class = "form-control select2" })
