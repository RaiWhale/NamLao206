                    @Html.DropDownList("DonViTienTe_Id", null, new { @class = "form-control select2" })
                    @Html.ValidationMessageFor(model => model.DonViTienTe_Id, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.Note, "Ghi chú", new { @class = "control-label" })
                    @Html.EditorFor(model => model.Note, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
                </div>
            </div>

        </div> <!-- end main row -->
        <!-- Nút hành động -->
        <div class="form-group text-end mt-4">
            <button type="submit" class="btn btn-success me-2">Lưu</button>
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
        </div>
    </div>
