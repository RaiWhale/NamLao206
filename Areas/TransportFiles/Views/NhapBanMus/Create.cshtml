                <div class="row g-3">
                    <div class="col-lg-6 col-md-9">
                        <div class="form-group">
                            @Html.LabelFor(model => model.DoiTac_Id, "Đối tác", new { @class = "control-label" })
                            @Html.DropDownList("DoiTac_Id", null, new { @class = "form-control select2 js-states" })
                            @Html.ValidationMessageFor(model => model.DoiTac_Id, "", new { @class = "text-danger" })
