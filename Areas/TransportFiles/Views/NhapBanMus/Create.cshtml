                    @Html.LabelFor(model => model.LoaiHs, "Loại hồ sơ", new { @class = "control-label" })
                    @Html.DropDownList("LoaiHs", null, new { @class = "form-control select2 js-states" })
                    @Html.ValidationMessageFor(model => model.LoaiHs, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Loại thống kê - chỉ hiện khi LoaiHs = 3 -->
            <div id="loaitk-section" class="col-lg-6 col-md-9 d-none">
                <div class="form-group">
                    @Html.LabelFor(model => model.LoaiTK, "Loại thống kê", new { @class = "control-label" })
