
@model IEnumerable<NamLao206.Models.NhapBanMu>
@using NamLao206.Models
@{

    namlao206_websiteEntities db = new namlao206_websiteEntities();

    var Donvi = ViewBag.Donvi as DM_DonVis;
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <!-- Hiển thị thông báo (nếu có) -->
    <div id="alert-container" data-message="@Html.Raw(HttpUtility.HtmlEncode(ViewBag.Message))"></div>
    <div class="row">
            <div class="col-lg-4 col-sm-8 col-xs-12">
                <div id="panel-1" class="panel panel-icon">
                    <div class="panel-hdr">
                        <h2 style="font-size: 150%">
                            Tạo mới <span class="fw-300"><i><b class="color-success-900">và tìm kiếm</b></i></span>
                        </h2>
                        <div class="panel-toolbar">
                            <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                                <svg class="sa-icon">
                                    <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                                    <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                                </svg>
                            </button>
                            <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
                                <svg class="sa-icon">
                                    <use href="~/Content/smartadminNew/icons/sprite.svg#stop-circle"></use>
                                </svg>
                            </button>
                            <button type="button" class="btn btn-panel" data-action="panel-close" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Close">
                                <svg class="sa-icon">
                                    <use href="~/Content/smartadminNew/icons/sprite.svg#x-circle"></use>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="panel-container show">
                        <div class="panel-content">
                            @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                <div class="frame-wrap">
                                    <div class="demo">
                                        <a href="@Url.Action("Create")" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                            <span class="fal fa-download mr-1"></span>Tạo mới
                                        </a>
                                        <input type="text" name="search" class="search form-control" placeholder="Tìm kiếm" value="@ViewBag.search">

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
    </div>
    <div class="row">
            <div class="col-lg-12 col-sm-12 col-xs-12 ">
                <div id="panel-1" class="panel panel-icon">
                    <div class="panel-hdr">
                        <h2>
                            Dự<span class="fw-300"><i>Án</i></span>
                        </h2>
                        <div class="panel-toolbar">
                            <button type="button" class="btn btn-panel" data-action="panel-collapse" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Toggle">
                                <svg class="sa-icon">
                                    <use class="panel-collapsed-icon" href="~/Content/smartadminNew/img/sprite.svg#minus-circle"></use>
                                    <use class="panel-expand-icon" href="~/Content/smartadminNew/img/sprite.svg#plus-circle"></use>
                                </svg>
                            </button>
                            <button type="button" class="btn btn-panel" data-action="panel-fullscreen" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Fullscreen">
                                <svg class="sa-icon">
                                    <use href="~/Content/smartadminNew/icons/sprite.svg#stop-circle"></use>
                                </svg>
                            </button>
                            <button type="button" class="btn btn-panel" data-action="panel-close" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-offset="0,10" data-bs-original-title="Close">
                                <svg class="sa-icon">
                                    <use href="~/Content/smartadminNew/icons/sprite.svg#x-circle"></use>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="panel-container show">
                        <div class="panel-content">
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover table-striped w-100 dt-basic-example" style="font-size: 15px">
                                        <thead class="bg-warning-200 text-center">
                                            <tr>
                                                <th>
                                                    Mã dự án
                                                </th>
                                                <th>
                                                    Tên dự án
                                                </th>
                                                <th>
                                                    Đội thực hiện
                                                </th>
                                                <th>
                                                    Ngày nhập
                                                </th>
                                                <th>
                                                    Tình trạng
                                                </th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>
                                                        <a href="@Url.Action("Details", new { id = item.Id })">
                                                            @Html.DisplayFor(modelItem => item.MaPhieu)
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <a href="@Url.Action("Details", new { id = item.Id })" style="text-decoration: underline;">
                                                            @Html.DisplayFor(modelItem => item.TenPhieu)
                                                        </a>
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Team.TeamName)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.NgayNhap)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.TinhTrang)
                                                    </td>
                                                    <td>
                                                        @*<a class="badge bg-success mr-2" data-toggle="tooltip" data-placement="top" data-title="Chi tiết" data-original-title="Chi tiết"
                                                href="@Url.Action("InformationProject", new { projectID = item.Id })"><i class="ni ni-wrench fa-2x"></i></a>*@
                                                        <a class="badge bg-info mr-2 bcommand" data-toggle="tooltip" data-placement="top" data-title="Sửa" data-original-title="Sửa"
                                                           href="@Url.Action("Edit", new { id = item.Id })"><i class="fal fa-edit fa-2x"></i></a>
                                                        <a class="badge bg-warning mr-2 bcommand" data-toggle="tooltip" data-placement="top" data-title="Xóa" data-original-title="Xóa"
                                                           href="@Url.Action("Delete", new { id = item.Id })"><i class="ni ni-trash fa-2x"></i></a>

                                                        <a href="@Url.Action("Create","HoSoPhapLies",new {NhapBanMu_Id = item.Id})" class="bcommand btn btn-md btn-primary waves-effect waves-themed">
                                                            <span class="fal fa-folder mr-1"></span>Hồ sơ pháp lý
                                                        </a>

                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    </div>

}