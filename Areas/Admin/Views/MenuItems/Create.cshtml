                            @Html.EditorFor(model => model.DisplayOrder, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.DisplayOrder, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-9 col-xs-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DepartmentId, "Đơn vị", htmlAttributes: new { @class = "control-label col-md-6" })
                        <div class="col-md-10">
                            @Html.DropDownList("Departments",  null, "--Chọn đơn vị--", htmlAttributes: new { @class = "form-control select2" })
