@using NamLao206.Models
@using NamLao206.Utils
@using PagedList.Mvc
@using PagedList
@model PagedList.IPagedList<NamLao206.Models.DM_Donvihanhchinhs>

@{

}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <div class="header-title">
                    <a href="@Url.Action("Create")" class="btn btn-primary add-list bcommand"><i class="las la-plus mr-3"></i>Tạo mới</a>

                    <a href="@Url.Action("DVHC")" class="btn btn-primary add-list"><i class="las la-plus mr-3"></i>Đồng bộ</a>
                </div>
                @using (Html.BeginForm())
                {
                    <div class="search col-md-2 col-xl-auto col-sm-auto dt-buttons" style="float:right;">
                        <div class="search-box">
                            <div class="input-group">
                                <input type="text" name="search" placeholder="Tìm theo tên" class="form-control" />
                                <span class="input-group-btn">
                                    <button class="btn btn-info add-list" type="submit">Tìm kiếm</button>
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="card-body">

                <div class="table-responsive">
                    <table id="datatable" class="table data-table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Tên</th>
                                <th>Mã</th>
                                <th>Mã cấp trên</th>
                                <th>Cấp</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Ten)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Ma)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ParentId)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CapId)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.IsActive)
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center list-action">
                                            <a class="badge bg-success mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Sửa"
                                               href="@Url.Action("Edit", new { id = item.Id })"><i class="ri-pencil-line mr-0"></i></a>
                                            <a class="badge bg-warning mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Xóa"
                                               href="@Url.Action("Delete", new { id = item.Id })"><i class="ri-delete-bin-line mr-0"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                        </tfoot>
                    </table>
                    @Html.PagedListPager(Model, page => Url.Action("Index", new { page, search = ViewBag.search }))
                </div>
            </div>
        </div>
    </div>
</div>



