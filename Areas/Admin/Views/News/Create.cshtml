@model NamLao206.Models.News


@{
    var page = ViewBag.page;
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <!-- Hiển thị thông báo (nếu có) -->
    <div id="alert-container" data-message="@Html.Raw(HttpUtility.HtmlEncode(ViewBag.Message))"></div>
    <input name="page" id="page" value="@page" hidden />
    <div class="row">
        <div class="container-fluid" style="margin-top:10px">
            <div class="col-lg-12 col-sm-12 col-xs-12 ">
                <div id="panel-1" class="panel">
                    <div class="panel-hdr">
                        <h2>
                            Quản lý <span class="fw-300"><i>@ViewBag.Title</i></span>
                        </h2>
                    </div>
                    <div class="panel-container show">
                        <div class="panel-content">
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="row">
                                    <div class="col-lg-6 col-sm-9 col-xs-12">
                                        @Html.Label("Tiêu đề", htmlAttributes: new { @class = "control-label col-md-6" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control is-invalid-cus", @placeholder = "Tiêu đề", required = "required" } })
                                            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-sm-9 col-xs-12">
                                        @Html.Label("Nhóm tin tức", htmlAttributes: new { @class = "control-label col-md-6" })
                                        <div class="col-md-10">
                                            @Html.DropDownListFor(model => model.TopicId, null, "--Chọn nhóm tin tức --", htmlAttributes: new { @class = "form-control is-invalid-cus select2" })
                                            @Html.ValidationMessageFor(model => model.TopicId, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-6 col-sm-9 col-xs-12">
                                        @Html.Label("Nhóm tin con", htmlAttributes: new { @class = "control-label col-md-6" })
                                        <div class="col-md-10">
                                            @Html.DropDownListFor(model => model.SubMenuId, new SelectList(" "), "--Chọn nhóm tin tức --", htmlAttributes: new { @class = "form-control is-invalid-cus select2"})
                                            @Html.ValidationMessageFor(model => model.SubMenuId, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                  
                                </div>
                                <div class="form-group">
                                    @Html.Label("Tóm tắt", htmlAttributes: new { @class = "control-label col-md-6" })
                                    <div class="col-md-12">
                                        @Html.TextAreaFor(model => model.Summary, htmlAttributes: new { @class = "form-control is-invalid-cus", @placeholder = "Không quá 100 chữ", required = "required" })
                                        @Html.ValidationMessageFor(model => model.Summary, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.Label("Chi tiết bài đăng", htmlAttributes: new { @class = "control-label col-md-6" })
                                    <div class="col-md-12">
                                        @Html.TextAreaFor(model => model.Details, htmlAttributes: new { @class = "form-control is-invalid-cus textarea-cus", required = "required" })
                                        @Html.ValidationMessageFor(model => model.Details, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-3 col-sm-8 col-xs-12">
                                        <div class="form-group">
                                            <label class="control-label col-md-3" for="Logo">Hình ảnh:</label>
                                            <div class="col-md-10">
                                                <input type="file" class="btn btn-outline-primary rounded-pill mt-2 is-invalid-cus" name="pic" id="pic" placeholder="Hình ảnh" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-sm-8 col-xs-12">
                                        @Html.Label("Tác giả", htmlAttributes: new { @class = "control-label col-md-6" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.Author, new { htmlAttributes = new { @class = "form-control is-invalid-cus", @placeholder = "Tác giả", required = "required" } })
                                            @Html.ValidationMessageFor(model => model.Author, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-sm-8 col-xs-12">
                                        @Html.Label("Ngày đăng", htmlAttributes: new { @class = "control-label col-md-6" })
                                        <div class="col-md-10">                          
                                            <input type="datetime-local" class="form-control" data-lang="en" data-RTL="false" id="DateUp" name="DateUp" data-date-autoclose="true" required value="@DateTime.Now.ToString("s")" />
                                            @Html.ValidationMessageFor(model => model.DateUp, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-sm-8 col-xs-12">
                                        <div class="input-group  col-md-5">
                                            <div class="input-group-prepend text-center">
                                                <span class="input-group-text" id="basic-addon1">Ưu tiên</span>
                                            </div>
                                            <input class="form-control" type="checkbox" name="uutien" id="uutien" value="true" />
                                        </div>
                                    </div>
                                </div>
                           
                            </div>
                            <div class="form-group" style="float:right">
                                <button type="submit" class="mt-2 btn btn-success">Lưu</button>
                                <a class="mt-2 btn btn-light" href="/Admin/News">Đóng</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
