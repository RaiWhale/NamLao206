@model IEnumerable<NamLao206.Models.Topic>
@{
    var submenus = Model.SelectMany(x => x.SubMenus);
    if (ViewBag.cat != null)
    {
        submenus = Model.First(x => x.Id == ViewBag.cat).SubMenus;
    }
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <!-- Hiển thị thông báo (nếu có) -->
    <div id="alert-container" data-message="@Html.Raw(HttpUtility.HtmlEncode(ViewBag.Message))"></div>
    <div class="row">
        <div class="container-fluid" style="margin-top:10px">
            <div class="col-lg-4 col-sm-8 col-xs-12">
                <div id="panel-2" class="panel panel-collapsed">
                    <div class="panel-hdr">
                        <h2 style="font-size: 150%">
                            Tạo mới <span class="fw-300"><i><b class="color-success-900">và tìm kiếm</b></i></span>
                        </h2>
                    </div>
                    <div class="panel-container show">
                        <div class="panel-content">
                            @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <a href="@Url.Action("Create","Topics")" class="bcommand btn btn-md btn-success waves-effect waves-themed">
                                            <span class="fal fa-download mr-1"></span>Tạo mới
                                        </a>
                                    </div>
                                    <div class="d-flex position-relative ml-auto" style="max-width: 23rem;">
                                        <i class="fas fa-search position-absolute pos-left fs-lg px-3 py-2 mt-1"></i>
                                        <input type="text" name="search" class="search form-control bg-subtlelight pl-6" placeholder="Tìm kiếm">
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="container-fluid" style="margin-top:10px">
            <div class="col-lg-12 col-sm-12 col-xs-12 ">
                <div id="panel-1" class="panel">
                    <div class="panel-hdr">
                        <h2>
                            Quản lý <span class="fw-300"><i>@ViewBag.Title</i></span>
                        </h2>
                    </div>
                    <div class="panel-container show">
                        <div class="panel-content">
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover table-striped w-100 dt-basic-example" style="font-size: calc(0.3vw + 10px) ">
                                        <thead class="bg-warning-200 text-center">
                                            <tr>
                                                <th>Nhóm tin</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td @(ViewBag.cat == item.Id ? Html.Raw("class=\"font-bold\"") : Html.Raw(""))>
                                                        @Html.ActionLink(item.TopicName, "Index", new { id = item.Id })
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center list-action">
                                                            <a class="badge bg-success mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Thêm"
                                                               href="@Url.Action( "Create", "SubMenus", new { topicId = item.Id })"><i class="fal fa-plus fa-2x"></i></a>
                                                            <a class="badge bg-success mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Sửa"
                                                               href="@Url.Action("Edit","Topics", new { id = item.Id })"><i class="ni ni-wrench fa-2x"></i></a>
                                                            <a class="badge bg-warning mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Xóa"
                                                               href="@Url.Action("Delete","Topics", new { id = item.Id })"><i class="ni ni-trash fa-2x"></i></a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td @(ViewBag.cat == null ? Html.Raw("class=\"font-bold\"") : Html.Raw(""))>
                                                    @Html.ActionLink("Tất cả(*)", "Index", new { id = "" })
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="container-fluid" style="margin-top:10px">
            <div class="col-lg-12 col-sm-12 col-xs-12 ">
                <div id="panel-1" class="panel">
                    <div class="panel-hdr">
                        <h2>
                            Quản lý <span class="fw-300"><i>@ViewBag.Title</i></span>
                        </h2>
                    </div>
                    <div class="panel-container show">
                        <div class="panel-content">
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover table-striped w-100 dt-basic-example" style="font-size: calc(0.3vw + 10px) ">
                                        <thead class="bg-warning-200 text-center">
                                            <tr>
                                                <th>#</th>
                                                <th>Tên menu con</th>
                                                <th>Tên nhóm</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in submenus.Where(x => x.ParentId == 0 || x.ParentId == null))
                                            {

                                                <tr>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Id)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.subMenuName)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Topic.TopicName)
                                                    </td>
                                                    <td class="text-center">
                                                        <a class="badge bg-success mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Thêm"
                                                           href="@Url.Action("Create", "SubMenus", new { id = item.Id  , topicId = item.TopicId})"><i class="fal fa-plus fa-2x"></i></a>
                                                        <a class="badge bg-success mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Sửa"
                                                           href="@Url.Action("Edit","SubMenus", new { id = item.Id })"><i class="ni ni-wrench fa-2x"></i></a>
                                                        <a class="badge bg-warning mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Xóa"
                                                           href="@Url.Action("Delete","SubMenus", new { id = item.Id })"><i class="ni ni-trash fa-2x"></i></a>
                                                    </td>
                                                </tr>
                                                var subInSub = submenus.Where(x => x.ParentId == item.Id);
                                                foreach (var sub in subInSub)
                                                {
                                                    <tr>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => sub.Id)
                                                        </td>
                                                        <td>
                                                            &nbsp; &nbsp;+ @Html.DisplayFor(modelItem => sub.subMenuName)
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => item.Topic.TopicName)  ->  @Html.DisplayFor(modelItem => item.subMenuName)
                                                        </td>
                                                        <td class="text-center">
                                                            <a class="badge bg-success mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Sửa"
                                                               href="@Url.Action("Edit","SubMenus", new { id = item.Id })"><i class="ni ni-wrench fa-2x"></i></a>
                                                            <a class="badge bg-warning mr-2 bcommand" data-toggle="tooltip" data-placement="top" title="" data-original-title="Xóa"
                                                               href="@Url.Action("Delete","SubMenus", new { id = item.Id })"><i class="ni ni-trash fa-2x"></i></a>
                                                        </td>
                                                    </tr>
                                                }
                                            }                                   
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td @(ViewBag.cat == null ? Html.Raw("class=\"font-bold\"") : Html.Raw(""))>
                                                    @Html.ActionLink("Tất cả(*)", "Index", new { id = "" })
                                                </td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
