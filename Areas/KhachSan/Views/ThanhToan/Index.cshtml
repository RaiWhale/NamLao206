@using NamLao206.Models
@model List<KhachSan_ThanhToan>

@{
    var datPhong = ViewBag.DatPhong as KhachSan_DatPhong;
    decimal conLai = ViewBag.ConLai is decimal c ? c : 0m;
    ViewBag.Title = $"Thanh toán - {datPhong?.MaPhieu}";
}

<div class="subheader">
    <h1 class="subheader-title"><i class="fal fa-money-bill"></i> Thanh toán</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index","CheckOut",new{area="KhachSan"})">Check-Out</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("ChiTiet","CheckOut",new{area="KhachSan",id=datPhong?.Id})">@datPhong?.MaPhieu</a></li>
            <li class="breadcrumb-item active">Thanh toán</li>
        </ol>
    </nav>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

<div class="row">
    <div class="col-md-8">
        <!-- Tóm tắt -->
        <div class="row mb-3">
            <div class="col-4">
                <div class="card text-center py-3">
                    <div class="text-muted small">Tổng cộng</div>
                    <div class="h5 font-weight-bold mb-0">@datPhong?.TongTien.ToString("N0") đ</div>
                </div>
            </div>
            <div class="col-4">
                <div class="card text-center py-3">
                    <div class="text-muted small">Đã thanh toán</div>
                    <div class="h5 font-weight-bold text-success mb-0">@datPhong?.DaThanhToan.ToString("N0") đ</div>
                </div>
            </div>
            <div class="col-4">
                <div class="card text-center py-3 @(conLai > 0 ? "border-danger" : "border-success")">
                    <div class="text-muted small">Còn lại</div>
                    <div class="h5 font-weight-bold @(conLai > 0 ? "text-danger" : "text-success") mb-0">
                        @conLai.ToString("N0") đ
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Lịch sử thanh toán</h5></div>
            <div class="card-body p-0">
                <table class="table table-hover table-sm mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Ngày thu</th>
                            <th>Hình thức</th>
                            <th>Mã giao dịch</th>
                            <th class="text-right">Số tiền</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tt in Model)
                        {
                            var htStr = tt.HinhThuc == 1 ? "Tiền mặt" : tt.HinhThuc == 2 ? "Chuyển khoản" : tt.HinhThuc == 3 ? "Thẻ NH" : "Ví điện tử";
                            <tr>
                                <td>@tt.NgayThu.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge badge-info">@htStr</span></td>
                                <td>@(tt.MaGiaoDich ?? "-")</td>
                                <td class="text-right font-weight-bold">@tt.SoTien.ToString("N0") đ</td>
                                <td>@tt.GhiChu</td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">Chưa có thanh toán nào.</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="font-weight-bold table-light">
                            <td colspan="3" class="text-right">Tổng:</td>
                            <td class="text-right">@Model.Sum(t => t.SoTien).ToString("N0") đ</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Ghi nhận thanh toán</h5></div>
            <div class="card-body">
                <form method="post" action="@Url.Action("ThemThanhToan", "ThanhToan", new { area = "KhachSan" })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="datPhongId" value="@datPhong?.Id" />
                    <div class="form-group mb-2">
                        <label>Số tiền <span class="text-danger">*</span></label>
                        <input type="number" name="soTien" class="form-control" value="@conLai" min="0" step="1000" required />
                    </div>
                    <div class="form-group mb-2">
                        <label>Hình thức <span class="text-danger">*</span></label>
                        <select name="hinhThuc" class="form-control" required>
                            <option value="1">Tiền mặt</option>
                            <option value="2">Chuyển khoản</option>
                            <option value="3">Thẻ ngân hàng</option>
                            <option value="4">Ví điện tử</option>
                        </select>
                    </div>
                    <div class="form-group mb-2">
                        <label>Mã giao dịch</label>
                        <input type="text" name="maGiaoDich" class="form-control" placeholder="Tuỳ chọn" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Ghi chú</label>
                        <input type="text" name="ghiChu" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-success btn-block">
                        <i class="fal fa-check"></i> Xác nhận thanh toán
                    </button>
                </form>
            </div>
        </div>
        <div class="mt-2">
            <a href="@Url.Action("ChiTiet","CheckOut",new{area="KhachSan",id=datPhong?.Id})" class="btn btn-secondary btn-block">
                <i class="fal fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>
</div>
