@using NamLao206.Models
@model List<KhachSan_DatPhong>

@{
    ViewBag.Title = "Danh sách phòng đang ở";
}

<div class="subheader">
    <h1 class="subheader-title"><i class="fal fa-sign-out-alt"></i> Check-Out</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="KhachSan"})">Khách sạn</a></li>
            <li class="breadcrumb-item active">Check-Out</li>
        </ol>
    </nav>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Phòng đang có khách (@Model.Count)</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Phòng</th>
                        <th>Loại phòng</th>
                        <th>Khách hàng</th>
                        <th>Check-in</th>
                        <th>Thời gian ở</th>
                        <th>Check-out DK</th>
                        <th class="text-right">Tổng tiền (TT)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        var duration = DateTime.Now - d.ThoiGianCheckIn;
                        var durationStr = duration.TotalHours >= 24
                            ? $"{(int)duration.TotalDays}n {duration.Hours}h"
                            : $"{(int)duration.TotalHours}h {duration.Minutes}m";
                        var isOverdue = d.ThoiGianCheckOutDuKien.HasValue && DateTime.Now > d.ThoiGianCheckOutDuKien.Value;
                        <tr class="@(isOverdue ? "table-warning" : "")">
                            <td><strong>@d.MaPhieu</strong></td>
                            <td>@(d.KhachSan_Phong != null ? d.KhachSan_Phong.SoPhong : "")</td>
                            <td>@(d.KhachSan_Phong != null && d.KhachSan_Phong.KhachSan_LoaiPhong != null ? d.KhachSan_Phong.KhachSan_LoaiPhong.TenLoai : "")</td>
                            <td>@(d.KhachSan_KhachHang != null ? d.KhachSan_KhachHang.HoTen : "")</td>
                            <td>@d.ThoiGianCheckIn.ToString("dd/MM HH:mm")</td>
                            <td>@durationStr</td>
                            <td>
                                @if (d.ThoiGianCheckOutDuKien.HasValue)
                                {
                                    <span class="@(isOverdue ? "text-danger font-weight-bold" : "")">
                                        @d.ThoiGianCheckOutDuKien.Value.ToString("dd/MM HH:mm")
                                    </span>
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td class="text-right">@d.TongTien.ToString("N0") đ</td>
                            <td>
                                <a href="@Url.Action("ChiTiet","CheckOut",new{area="KhachSan",id=d.Id})"
                                   class="btn btn-sm btn-primary">
                                    <i class="fal fa-sign-out-alt"></i> Check-Out
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">Không có phòng nào đang có khách.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
