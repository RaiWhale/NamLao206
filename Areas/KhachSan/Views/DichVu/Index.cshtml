@using NamLao206.Models
@model List<KhachSan_DichVuPhuThu>

@{
    var datPhong = ViewBag.DatPhong as KhachSan_DatPhong;
    ViewBag.Title = $"Dịch vụ - {datPhong?.MaPhieu}";
}

<div class="subheader">
    <h1 class="subheader-title"><i class="fal fa-concierge-bell"></i> Dịch vụ phụ thu</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index","CheckOut",new{area="KhachSan"})">Check-Out</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("ChiTiet","CheckOut",new{area="KhachSan",id=datPhong?.Id})">@datPhong?.MaPhieu</a></li>
            <li class="breadcrumb-item active">Dịch vụ</li>
        </ol>
    </nav>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header"><h5 class="card-title mb-0">Danh sách dịch vụ - Phiếu @datPhong?.MaPhieu</h5></div>
            <div class="card-body p-0">
                <table class="table table-hover table-sm mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Dịch vụ</th>
                            <th class="text-right">SL</th>
                            <th class="text-right">Đơn giá</th>
                            <th class="text-right">Thành tiền</th>
                            <th>Ngày</th>
                            <th>Ghi chú</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dv in Model)
                        {
                            <tr>
                                <td>@dv.TenDichVu</td>
                                <td class="text-right">@dv.SoLuong</td>
                                <td class="text-right">@dv.DonGia.ToString("N0")</td>
                                <td class="text-right font-weight-bold">@dv.ThanhTien.ToString("N0") đ</td>
                                <td>@dv.NgayPhatSinh.ToString("dd/MM HH:mm")</td>
                                <td>@dv.GhiChu</td>
                                <td>
                                    <form method="post" action="@Url.Action("XoaDichVu", "DichVu", new { area = "KhachSan" })"
                                          style="display:inline;" onsubmit="return confirm('Xóa dịch vụ này?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@dv.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fal fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-3">Chưa có dịch vụ nào.</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="font-weight-bold table-light">
                            <td colspan="3" class="text-right">Tổng phụ thu:</td>
                            <td class="text-right">@Model.Sum(d => d.ThanhTien).ToString("N0") đ</td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Thêm dịch vụ</h5></div>
            <div class="card-body">
                <form method="post" action="@Url.Action("ThemDichVu", "DichVu", new { area = "KhachSan" })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="datPhongId" value="@datPhong?.Id" />
                    <div class="form-group mb-2">
                        <label>Tên dịch vụ <span class="text-danger">*</span></label>
                        <input type="text" name="tenDichVu" class="form-control" required placeholder="VD: Nước suối, Ăn sáng..." />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group mb-2">
                                <label>Số lượng</label>
                                <input type="number" name="soLuong" class="form-control" value="1" min="1" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group mb-2">
                                <label>Đơn giá</label>
                                <input type="number" name="donGia" class="form-control" value="0" min="0" step="1000" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label>Ghi chú</label>
                        <input type="text" name="ghiChu" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fal fa-plus"></i> Thêm dịch vụ
                    </button>
                </form>
            </div>
        </div>
        <div class="mt-2">
            <a href="@Url.Action("ChiTiet","CheckOut",new{area="KhachSan",id=datPhong?.Id})" class="btn btn-secondary btn-block">
                <i class="fal fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>
</div>
