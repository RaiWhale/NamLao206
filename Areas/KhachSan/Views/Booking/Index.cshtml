@using NamLao206.Models
@model List<KhachSan_DatPhong>

@{
    ViewBag.Title = "Đặt phòng trước";
}

<div class="subheader">
    <h1 class="subheader-title"><i class="fal fa-calendar-check"></i> Đặt phòng trước</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="KhachSan"})">Khách sạn</a></li>
            <li class="breadcrumb-item active">Booking</li>
        </ol>
    </nav>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <ul class="nav nav-tabs card-header-tabs" id="bookingTabs">
            <li class="nav-item">
                <a class="nav-link active" href="#choXN" data-toggle="tab">
                    Chờ xác nhận
                    <span class="badge badge-warning ml-1">@Model.Count(d => d.TrangThai == 0)</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#daXN" data-toggle="tab">
                    Đã xác nhận
                    <span class="badge badge-success ml-1">@Model.Count(d => d.TrangThai == 1)</span>
                </a>
            </li>
        </ul>
        <a href="@Url.Action("Create","Booking",new{area="KhachSan"})" class="btn btn-primary btn-sm">
            <i class="fal fa-plus"></i> Đặt phòng mới
        </a>
    </div>
    <div class="card-body p-0">
        <div class="tab-content">
            @foreach (var (tabId, trangThai, label) in new[]{("choXN",0,"Chờ XN"),("daXN",1,"Đã XN")})
            {
                var rows = Model.Where(d => d.TrangThai == trangThai).ToList();
                <div class="tab-pane @(tabId=="choXN"?"active":"")" id="@tabId">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Mã phiếu</th>
                                    <th>Phòng</th>
                                    <th>Khách hàng</th>
                                    <th>Check-in DK</th>
                                    <th>Nguồn</th>
                                    <th>Ngày tạo</th>
                                    <th class="text-right">Tổng tiền</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in rows)
                                {
                                    var nguonStr = d.NguonBooking == 1 ? "Walk-in" : d.NguonBooking == 2 ? "Phone" : d.NguonBooking == 3 ? "Agoda" : d.NguonBooking == 4 ? "Booking" : d.NguonBooking == 5 ? "FB" : "Web";
                                    <tr>
                                        <td><strong>@d.MaPhieu</strong></td>
                                        <td>@(d.KhachSan_Phong != null ? d.KhachSan_Phong.SoPhong : "")</td>
                                        <td>@(d.KhachSan_KhachHang != null ? d.KhachSan_KhachHang.HoTen : "")</td>
                                        <td>@d.ThoiGianCheckIn.ToString("dd/MM/yy HH:mm")</td>
                                        <td><span class="badge badge-info">@nguonStr</span></td>
                                        <td>@d.NgayTao.ToString("dd/MM/yy")</td>
                                        <td class="text-right">@d.TongTien.ToString("N0") đ</td>
                                        <td>
                                            @if (d.TrangThai == 0)
                                            {
                                                <form method="post" action="@Url.Action("XacNhan", "Booking", new { area = "KhachSan" })" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@d.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success" title="Xác nhận">
                                                        <i class="fal fa-check"></i>
                                                    </button>
                                                </form>
                                            }
                                            @if (d.TrangThai == 1)
                                            {
                                                <a href="@Url.Action("XacNhanCheckIn","Booking",new{area="KhachSan",id=d.Id})"
                                                   class="btn btn-sm btn-primary" title="Nhận phòng"
                                                   onclick="return confirm('Xác nhận nhận phòng @d.MaPhieu?')">
                                                    <i class="fal fa-sign-in-alt"></i>
                                                </a>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="huyBooking(@d.Id)" title="Hủy">
                                                <i class="fal fa-times"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (!rows.Any())
                                {
                                    <tr><td colspan="8" class="text-center text-muted py-4">Không có booking @label nào.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal hủy -->
<div class="modal fade" id="huyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("Huy", "Booking", new { area = "KhachSan" })" id="huyForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="huyId" />
                <div class="modal-header">
                    <h5 class="modal-title">Hủy đặt phòng</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-0">
                        <label>Lý do hủy <span class="text-danger">*</span></label>
                        <textarea name="lyDo" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function huyBooking(id) {
        document.getElementById('huyId').value = id;
        $('#huyModal').modal('show');
    }
</script>
