                            <svg class="sa-icon"><use href="~/Content/smartadminNew/icons/sprite.svg#log-out"></use></svg>
                            <span class="nav-link-text">Check-Out</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "DichVu", new { area = "KhachSan" })">
                            <svg class="sa-icon"><use href="~/Content/smartadminNew/icons/sprite.svg#aperture"></use></svg>
                            <span class="nav-link-text">Dịch vụ</span>
                        </a>
