                                <span class="text-truncate text-truncate-md opacity-80 fs-sm">@tenDonVi</span>
                            </div>
                        </div>
                    </div>
                    <div class="dropdown-divider m-0"></div>
                    <a href="#" class="dropdown-item" data-action="app-reset" role="button">
                        <span>Reset Layout</span>
                    </a>
                    <a href="@Url.Action("UpdateProfile", "Login", new { area = "" })" class="dropdown-item" role="button">
                        <span>Settings</span>
                    </a>
                    <div class="dropdown-divider m-0"></div>
                    <a href="#" class="dropdown-item d-flex justify-content-between align-items-center" data-action="app-fullscreen" role="button">
                        <span>Fullscreen</span>
