                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "CheckIn", new { area = "KhachSan" })">
                            <svg class="sa-icon"><use href="~/Content/smartadminNew/icons/sprite.svg#log-in"></use></svg>
