@using NamLao206.Models
@{
    namlao206_websiteEntities db = new namlao206_websiteEntities();
    Account acc = null;
    string hoTenNhanVien = "";
    string tenDonVi = "";

    if (User.Identity.IsAuthenticated)
    {
        acc = db.Accounts.Where(x => x.Id.ToString().Equals(User.Identity.Name)).SingleOrDefault();
        if (acc != null)
        {
            var emp = db.Employees.FirstOrDefault(e => e.Id == acc.EmployeeId);
            if (emp != null)
            {
                hoTenNhanVien = emp.Name ?? "";
                var pb = db.DM_PhongBans.Where(p => p.Id == emp.KhoaphongId).FirstOrDefault();
                if (pb != null && pb.donvi_Id.HasValue)
                {
                    var dv = db.DM_DonVis.FirstOrDefault(d => d.Id == pb.donvi_Id.Value);
                    if (dv != null) 
                    {
                        tenDonVi = dv.TenDonVi ?? "";
                        }
                }
            }
        }
        else
        {
            Response.Redirect(Url.Action("Logout", "Login", new { area = "" }));
        }
    }
}
<!DOCTYPE html>
