@using NamLao206.Models
@model List<KhachSan_KhachHang>

@{
    ViewBag.Title = "Danh sách khách hàng";
    string q = ViewBag.Q ?? "";
}

<div class="subheader">
    <h1 class="subheader-title"><i class="fal fa-users"></i> Khách hàng</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="KhachSan"})">Khách sạn</a></li>
            <li class="breadcrumb-item active">Khách hàng</li>
        </ol>
    </nav>
</div>

<div class="card">
    <div class="card-header">
        <form method="get" action="@Url.Action("Index", "KhachHang", new { area = "KhachSan" })" class="form-inline">
            <div class="input-group">
                <input type="text" name="q" value="@q" class="form-control" placeholder="Tìm theo CCCD hoặc họ tên..." style="width:300px;" />
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary"><i class="fal fa-search"></i> Tìm</button>
                </div>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>CCCD / Hộ chiếu</th>
                        <th>Họ tên</th>
                        <th>Điện thoại</th>
                        <th>Email</th>
                        <th>Quốc tịch</th>
                        <th>Ngày tạo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kh in Model)
                    {
                        <tr>
                            <td><code>@kh.CCCD</code></td>
                            <td><strong>@kh.HoTen</strong></td>
                            <td>@(kh.SoDienThoai ?? "-")</td>
                            <td>@(kh.Email ?? "-")</td>
                            <td>@(kh.QuocTich ?? "-")</td>
                            <td>@kh.NgayTao.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="@Url.Action("ChiTiet","KhachHang",new{area="KhachSan",id=kh.Id})"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fal fa-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Không tìm thấy khách hàng nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">Hiển thị @Model.Count kết quả</div>
</div>
