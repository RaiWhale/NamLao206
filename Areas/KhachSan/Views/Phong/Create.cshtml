@model NamLao206.Models.KhachSan_Phong
@{
    ViewBag.Title = "Thêm phòng";
}

<div class="subheader">
    <h1 class="subheader-title"><i class="fal fa-door-open mr-2"></i>Thêm phòng mới</h1>
    <div class="subheader-block">
        <a href="@Url.Action("Index", "Phong", new { area = "KhachSan" })" class="btn btn-sm btn-outline-secondary"><i class="fal fa-arrow-left mr-1"></i>Quay lại</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form action="@Url.Action("Create", "Phong", new { area = "KhachSan" })" method="post">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="SoPhong">Số phòng <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.SoPhong, new { @class = "form-control", placeholder = "VD: 101, A201" })
                        @Html.ValidationMessageFor(m => m.SoPhong, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="TenPhong">Tên phòng</label>
                        @Html.TextBoxFor(m => m.TenPhong, new { @class = "form-control", placeholder = "Tên gợi nhớ (tuỳ chọn)" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="LoaiPhongId">Loại phòng <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.LoaiPhongId, ViewBag.LoaiPhongs as SelectList, "-- Chọn loại phòng --", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LoaiPhongId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="Tang">Tầng</label>
                        @Html.TextBoxFor(m => m.Tang, new { @class = "form-control", type = "number", min = "0", placeholder = "0" })
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label for="MoTa">Mô tả</label>
                @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "2" })
            </div>
            <button type="submit" class="btn btn-primary"><i class="fal fa-save mr-1"></i>Lưu</button>
            <a href="@Url.Action("Index", "Phong", new { area = "KhachSan" })" class="btn btn-secondary ml-2">Hủy</a>
        </form>
    </div>
</div>
