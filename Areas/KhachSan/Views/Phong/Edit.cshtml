@model NamLao206.Models.KhachSan_Phong

<form action="@Url.Action("Edit", "Phong", new { area = "KhachSan", id = Model.Id })" method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label>Số phòng <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.SoPhong, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.SoPhong, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label>Tên phòng</label>
                @Html.TextBoxFor(m => m.TenPhong, new { @class = "form-control" })
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label>Loại phòng <span class="text-danger">*</span></label>
                @Html.DropDownListFor(m => m.LoaiPhongId, ViewBag.LoaiPhongs as SelectList, "-- Chọn loại phòng --", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.LoaiPhongId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label>Tầng</label>
                @Html.TextBoxFor(m => m.Tang, new { @class = "form-control", type = "number", min = "0" })
            </div>
        </div>
    </div>
    <div class="form-group">
        <label>Mô tả</label>
        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "2" })
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary"><i class="fal fa-save mr-1"></i>Lưu</button>
        <button type="button" class="btn btn-secondary ml-2" data-bs-dismiss="modal">Hủy</button>
    </div>
</form>
