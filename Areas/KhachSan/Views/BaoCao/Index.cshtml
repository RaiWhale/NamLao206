@using NamLao206.Models

@{
    ViewBag.Title = "Báo cáo doanh thu";
    decimal totalRevenue = ViewBag.TotalRevenue is decimal tr ? tr : 0m;
    int totalBookings = ViewBag.TotalBookings is int tb ? tb : 0;
    decimal avgRev = ViewBag.AvgRevPerRoom is decimal avg ? avg : 0m;
    string fromVal = ViewBag.From ?? "";
    string toVal = ViewBag.To ?? "";

    // Model is a list of anonymous objects — use dynamic
    var rows = Model as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="subheader">
    <h1 class="subheader-title"><i class="fal fa-chart-bar"></i> Báo cáo doanh thu</h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index","Dashboard",new{area="KhachSan"})">Khách sạn</a></li>
            <li class="breadcrumb-item active">Báo cáo</li>
        </ol>
    </nav>
</div>

<!-- Bộ lọc ngày -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" action="@Url.Action("Index", "BaoCao", new { area = "KhachSan" })" class="form-inline">
            <label class="mr-2">Từ ngày</label>
            <input type="date" name="from" value="@fromVal" class="form-control form-control-sm mr-2" />
            <label class="mr-2">Đến ngày</label>
            <input type="date" name="to" value="@toVal" class="form-control form-control-sm mr-2" />
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fal fa-search"></i> Xem báo cáo
            </button>
        </form>
    </div>
</div>

<!-- Summary cards -->
<div class="row mb-3">
    <div class="col-md-4">
        <div class="card text-center py-3 border-left border-success" style="border-left-width:4px!important;">
            <div class="text-muted small">Tổng doanh thu</div>
            <div class="h4 font-weight-bold text-success mb-0">@totalRevenue.ToString("N0") đ</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center py-3 border-left border-primary" style="border-left-width:4px!important;">
            <div class="text-muted small">Tổng phiếu check-out</div>
            <div class="h4 font-weight-bold text-primary mb-0">@totalBookings</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center py-3 border-left border-info" style="border-left-width:4px!important;">
            <div class="text-muted small">Doanh thu TB / phiếu</div>
            <div class="h4 font-weight-bold text-info mb-0">@avgRev.ToString("N0") đ</div>
        </div>
    </div>
</div>

<!-- Bảng theo ngày -->
<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Chi tiết theo ngày</h5></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Ngày</th>
                        <th class="text-right">Số phiếu</th>
                        <th class="text-right">Doanh thu</th>
                        <th class="text-right">Trung bình / phiếu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        DateTime ngay = r.Ngay;
                        int soPhieu = r.SoPhieu;
                        decimal doanhThu = r.DoanhThu;
                        <tr>
                            <td>@ngay.ToString("dd/MM/yyyy") <small class="text-muted">(@ngay.ToString("ddd", new System.Globalization.CultureInfo("vi-VN")))</small></td>
                            <td class="text-right">@soPhieu</td>
                            <td class="text-right font-weight-bold">@doanhThu.ToString("N0") đ</td>
                            <td class="text-right">@((soPhieu > 0 ? doanhThu / soPhieu : 0).ToString("N0")) đ</td>
                        </tr>
                    }
                    @if (!rows.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">Không có dữ liệu trong khoảng thời gian này.</td></tr>
                    }
                </tbody>
                @if (rows.Any())
                {
                    <tfoot>
                        <tr class="font-weight-bold table-light">
                            <td>Tổng cộng</td>
                            <td class="text-right">@totalBookings</td>
                            <td class="text-right">@totalRevenue.ToString("N0") đ</td>
                            <td class="text-right">@avgRev.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>
