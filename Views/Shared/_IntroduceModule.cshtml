@model IEnumerable<NamLao206.Models.AlbumPicture>
@using NamLao206.Utils

@foreach (var picture in Model)
{

    string src = "";
    var pic = picture.PictureName;

    src = "/Uploads/Albums/" + picture.AlbumId + "/" + pic;




    <div class="col-md-6 col-lg-4">
        <div class="feature-card">
            <div class="feature-image mb-4">

                <a href="@Url.Content($"{@picture.Url}")">
                    <img src="@src" alt="@picture.ten" class="img-fluid rounded-4">
                </a>
            </div>
            <h3 class="h4 fw-700 mb-3">@picture.ten</h3>
            <p class="text-muted">@picture.mota</p>
        </div>
    </div>
}